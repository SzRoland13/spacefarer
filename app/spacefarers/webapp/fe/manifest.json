{
  "_version": "1.65.0",
  "sap.app": {
    "id": "galactic.spacefarers.fe",
    "type": "application",
    "title": "Spacefarers",
    "applicationVersion": { "version": "1.0.0" },
    "dataSources": {
      "SpacefarerService": {
        "uri": "/odata/v4/spacefarer/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": { "sap.fe.templates": {}, "sap.m": {} }
    },
    "models": {
      "": {
        "dataSource": "SpacefarerService",
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        { "pattern": ":?query:", "name": "SpacefarerList", "target": "SpacefarerList" },
        { "pattern": "Spacefarers({key}):?query:", "name": "SpacefarerDetails", "target": "SpacefarerDetails" }
      ],
      "targets": {
        "SpacefarerList": {
          "type": "Component",
          "id": "SpacefarerList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Spacefarers",
              "initialLoad": "Enabled",
              "variantManagement": "None",
              "navigation": { "Spacefarers": { "detail": { "route": "SpacefarerDetails" } } },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": { "type": "ResponsiveTable", "selectionMode": "Multi", "enableExport": false }
                }
              }
            }
          }
        },
        "SpacefarerDetails": {
          "type": "Component",
          "id": "SpacefarerDetails",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": { "contextPath": "/Spacefarers", "editableHeaderContent": false }
          }
        }
      }
    },
    "contentDensities": { "compact": true, "cozy": true }
  }
}
